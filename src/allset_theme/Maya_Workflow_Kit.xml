<bpy>
  <!-- Maya Workflow Kit Theme: Maya's interface greys on top of Blender's default dark theme. Only the values
       listed here change; everything else stays Blender's default. Maya: #444444 panels and menu bars,
       #373737 separators, tab rows and list backgrounds, #2b2b2b fields, #5d5d5d buttons and frame headers,
       #525252 menus, #5285a6 selection, light text, pale yellow tooltips, square scroll bars. -->
  <Theme>
    <user_interface>
      <ThemeUserInterface
        editor_border="#373737"
        editor_outline="#44444400"
        panel_roundness="0.1"
        panel_header="#5d5d5dff"
        panel_back="#444444ff"
        panel_title="#bbbbbb"
        panel_text="#bbbbbb"
        >
        <wcol_regular>
          <ThemeWidgetColors
            outline="#626262ff"
            inner="#5d5d5dff"
            inner_sel="#5285a6ff"
            text="#eeeeee"
            text_sel="#ffffff"
            show_shaded="FALSE"
            roundness="0.1"
            />
        </wcol_regular>
        <wcol_tool>
          <ThemeWidgetColors
            outline="#626262ff"
            inner="#5d5d5dff"
            inner_sel="#5285a6ff"
            text="#eeeeee"
            text_sel="#ffffff"
            show_shaded="FALSE"
            roundness="0.1"
            />
        </wcol_tool>
        <wcol_toolbar_item>
          <ThemeWidgetColors
            inner="#444444ff"
            inner_sel="#5285a6ff"
            roundness="0.1"
            />
        </wcol_toolbar_item>
        <wcol_radio>
          <ThemeWidgetColors
            outline="#626262ff"
            inner="#5d5d5dff"
            inner_sel="#5285a6ff"
            text="#eeeeee"
            text_sel="#ffffff"
            show_shaded="FALSE"
            roundness="0.1"
            />
        </wcol_radio>
        <wcol_toggle>
          <ThemeWidgetColors
            outline="#626262ff"
            inner="#5d5d5dff"
            inner_sel="#5285a6ff"
            text="#eeeeee"
            text_sel="#ffffff"
            roundness="0.1"
            />
        </wcol_toggle>
        <wcol_menu>
          <ThemeWidgetColors
            outline="#626262ff"
            inner="#5d5d5dff"
            inner_sel="#5285a6ff"
            text="#eeeeee"
            text_sel="#ffffff"
            roundness="0.1"
            />
        </wcol_menu>
        <wcol_text>
          <ThemeWidgetColors
            outline="#2b2b2bff"
            inner="#2b2b2bff"
            text="#c8c8c8"
            roundness="0.1"
            />
        </wcol_text>
        <wcol_num>
          <ThemeWidgetColors
            outline="#2b2b2bff"
            inner="#2b2b2bff"
            text="#c8c8c8"
            roundness="0.1"
            />
        </wcol_num>
        <wcol_numslider>
          <ThemeWidgetColors
            outline="#2b2b2bff"
            inner="#2b2b2bff"
            text="#c8c8c8"
            roundness="0.1"
            />
        </wcol_numslider>
        <wcol_option>
          <ThemeWidgetColors
            outline="#2b2b2bff"
            inner="#2b2b2bff"
            inner_sel="#5285a6ff"
            item="#eeeeeeff"
            text="#bbbbbb"
            roundness="0.1"
            />
        </wcol_option>
        <wcol_box>
          <ThemeWidgetColors
            roundness="0.1"
            />
        </wcol_box>
        <wcol_pulldown>
          <ThemeWidgetColors
            inner_sel="#5285a6ff"
            text="#c8c8c8"
            text_sel="#ffffff"
            roundness="0"
            />
        </wcol_pulldown>
        <wcol_menu_back>
          <ThemeWidgetColors
            outline="#333333ff"
            inner="#525252ff"
            text="#eeeeee"
            roundness="0"
            />
        </wcol_menu_back>
        <wcol_menu_item>
          <ThemeWidgetColors
            inner_sel="#5285a6ff"
            text="#eeeeee"
            text_sel="#ffffff"
            roundness="0"
            />
        </wcol_menu_item>
        <wcol_tooltip>
          <ThemeWidgetColors
            outline="#000000ff"
            inner="#ffffdcff"
            text="#000000"
            roundness="0"
            />
        </wcol_tooltip>
        <wcol_list_item>
          <ThemeWidgetColors
            inner_sel="#5285a6ff"
            text="#bbbbbb"
            text_sel="#ffffff"
            roundness="0"
            />
        </wcol_list_item>
        <wcol_scroll>
          <ThemeWidgetColors
            outline="#373737ff"
            inner="#373737ff"
            item="#5d5d5dff"
            show_shaded="FALSE"
            roundness="0"
            />
        </wcol_scroll>
        <wcol_tab>
          <ThemeWidgetColors
            outline="#2b2b2bff"
            inner="#373737ff"
            inner_sel="#444444ff"
            text="#bbbbbb"
            text_sel="#eeeeee"
            roundness="0.1"
            />
        </wcol_tab>
      </ThemeUserInterface>
    </user_interface>
    <view_3d>
      <ThemeView3D>
        <space>
          <ThemeSpaceGradient header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeView3D>
    </view_3d>
    <graph_editor>
      <ThemeGraphEditor>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeGraphEditor>
    </graph_editor>
    <dopesheet_editor>
      <ThemeDopeSheet>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeDopeSheet>
    </dopesheet_editor>
    <nla_editor>
      <ThemeNLAEditor>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeNLAEditor>
    </nla_editor>
    <image_editor>
      <ThemeImageEditor>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeImageEditor>
    </image_editor>
    <sequence_editor>
      <ThemeSequenceEditor>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeSequenceEditor>
    </sequence_editor>
    <clip_editor>
      <ThemeClipEditor>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeClipEditor>
    </clip_editor>
    <node_editor>
      <ThemeNodeEditor>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeNodeEditor>
    </node_editor>
    <file_browser>
      <ThemeFileBrowser>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeFileBrowser>
    </file_browser>
    <spreadsheet>
      <ThemeSpreadsheet>
        <space>
          <ThemeSpaceGeneric header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeSpreadsheet>
    </spreadsheet>
    <properties>
      <ThemeProperties>
        <space>
          <ThemeSpaceGeneric back="#444444" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeProperties>
    </properties>
    <preferences>
      <ThemePreferences>
        <space>
          <ThemeSpaceGeneric back="#444444" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemePreferences>
    </preferences>
    <outliner>
      <ThemeOutliner
        selected_highlight="#5285a6"
        active="#5285a6"
        selected_object="#ffffff"
        active_object="#ffffff"
        >
        <space>
          <ThemeSpaceGeneric back="#373737" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeOutliner>
    </outliner>
    <text_editor>
      <ThemeTextEditor>
        <space>
          <ThemeSpaceGeneric back="#2b2b2b" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeTextEditor>
    </text_editor>
    <console>
      <ThemeConsole>
        <space>
          <ThemeSpaceGeneric back="#2b2b2b" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeConsole>
    </console>
    <info>
      <ThemeInfo>
        <space>
          <ThemeSpaceGeneric back="#2b2b2b" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeInfo>
    </info>
    <topbar>
      <ThemeTopBar>
        <space>
          <ThemeSpaceGeneric back="#444444" header="#444444b3" header_text="#c8c8c8" />
        </space>
      </ThemeTopBar>
    </topbar>
    <statusbar>
      <ThemeStatusBar>
        <space>
          <ThemeSpaceGeneric back="#444444" header="#444444b3" />
        </space>
      </ThemeStatusBar>
    </statusbar>
  </Theme>
  <ThemeStyle>
  </ThemeStyle>
</bpy>
